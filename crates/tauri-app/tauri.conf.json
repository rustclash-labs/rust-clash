{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustClash",
  "version": "0.3.2",
  "identifier": "io.github.rustclashlabs.rustclash",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "RustClash — Post-Quantum & Multi-Protocol Proxy Console",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://ipc.localhost; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT OR Apache-2.0",
    "targets": ["dmg", "app", "nsis", "msi", "deb", "rpm"],
    "resources": {
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
